<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TbTest</AssemblyName>
    <RootNamespace>TbTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 测试工程直接编译插件的真实源码，其中 TopmostEnforcer 用了
         LibraryImport（源生成封送），生成的代码需要 /unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.17" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.17" />
    <PackageReference Include="ClassIsland.Core" Version="2.1.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/ToolboxSettings.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/PickSettings.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/JsonStorage.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/ShortcutItem.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/PickStats.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Services/RosterService.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Services/ShortcutRunner.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Services/ShortcutPathResolver.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Services/FileIconLoader.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/ToolboxWindow.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/PieChartControl.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/CloudBackdrop.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/CloudButtonSurface.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/SettingsPages/ToolboxSettingsPage.axaml.cs" />
    <Compile Include="Stubs.cs" />
    <AvaloniaResource Include="../../src/ClassIsland.Toolbox/Views/SettingsPages/ToolboxSettingsPage.axaml"
                      Link="Views/SettingsPages/ToolboxSettingsPage.axaml" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/ControlExtensions.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/RevealWindow.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/AnnotationCanvas.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Views/AnnotationWindow.cs" />
    <Compile Include="../../src/ClassIsland.Toolbox/Models/AnnotationPalette.cs" />

    <Compile Include="../../src/ClassIsland.Toolbox/Interop/TopmostEnforcer.cs" />
  </ItemGroup>
</Project>
