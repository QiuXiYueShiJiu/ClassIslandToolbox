<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     x:Class="ClassIsland.Toolbox.Views.SettingsPages.ToolboxSettingsPage">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="工具条常驻屏幕最顶层。左键点圆钮向两边展开，按住拖动挪位置，右键出菜单。展开后圆钮居中，功能左右均分。幸运抽签是内置的，下面还可以再加任意条自己的快捷方式。除了点圆钮和点快捷方式，工具条不会自己收起来。"/>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE71D;" Text="功能" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE70F;}"
                                       Header="启用批注功能"
                                       Description="工具条上显示「批注」。点一下铺开全屏画布、默认红色软笔，再点一下多出工具栏行和配置行，第三次点收起。批注画在所有窗口之上，包括课件和视频。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding EnableAnnotate, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8AF;}"
                                       Header="启用幸运抽签"
                                       Description="关掉之后工具条上不再出现「幸运抽签」，右键菜单里相关的几项也会隐藏，下面整块幸运抽签设置会收起来。名单和幸运抽签次数历史都会原样保留，重新打开即可接着用。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding EnableLuckyDraw, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE8B7;" Text="悬浮钮" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE790;}"
                                       Header="悬浮窗透明度"
                                       Description="{Binding OpacitySummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="200" Minimum="30" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding OpacityPercent, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="64"
                                   Text="{Binding OpacityText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8B7;}"
                                       Header="主按钮大小"
                                       Description="{Binding SizeSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="200" Minimum="40" Maximum="140" TickFrequency="2"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding Diameter, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="64"
                                   Text="{Binding DiameterText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 幸运抽签相关的全部设置。关掉「启用幸运抽签」时整块收起来，
                 设置项不删：数据还在，重新打开就能接着用。 -->
            <StackPanel IsVisible="{Binding EnableLuckyDraw}">
            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE8AF;" Text="幸运抽签" Margin="0 0 0 4"/>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE8A5;}"
                                       Header="名单文件"
                                       Description="{Binding RosterSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnOpenRoster">
                            <ci:IconText Glyph="&#xE8E5;" Text="打开"/>
                        </Button>
                        <Button Click="OnReloadRoster">
                            <ci:IconText Glyph="&#xE117;" Text="重载"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE0BE;}"
                                       Header="新一轮开头回避"
                                       Description="每一轮的第一抽回避最近点过的人，避免「上一轮最后一个」立刻又成了「新一轮第一个」。只影响顺序，不影响次数。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="150" Minimum="0" Maximum="5" TickFrequency="1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding RoundStartAvoid, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="66"
                                   Text="{Binding RoundStartAvoidText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE9D2;}"
                                       Header="幸运抽签统计"
                                       Description="{Binding StatsSummary}">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnShowStats">
                            <ci:IconText Glyph="&#xE9D2;" Text="查看饼状图"/>
                        </Button>
                        <Button Click="OnResetRound">
                            <ci:IconText Glyph="&#xE72C;" Text="开始新一轮"/>
                        </Button>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE916;}"
                                       Header="大字停留"
                                       Description="幸运抽签结果在屏幕中央停留多久。">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Slider Width="160" Minimum="0.5" Maximum="10" TickFrequency="0.5"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding RevealSeconds, Mode=TwoWay}"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="54"
                                   Text="{Binding RevealSecondsText}"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE7E7;}"
                                       Header="同时发 ClassIsland 提醒"
                                       Description="幸运抽签之后除了中央大字，再往主界面推一条提醒。">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ShowNotification, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            </StackPanel>

            <Separator Margin="0 12 0 4"/>
            <ci:IconText Glyph="&#xE71D;" Text="快捷方式" Margin="0 0 0 4"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="除了内置的幸运抽签，这里加的每一条都会出现在工具条上，按钮上显示「图标 + 名称」。表单会跟着类型变：启动程序可以浏览 exe，打开文件/文件夹可以选文件和选文件夹，ClassIsland 地址有常用地址可选。指向文件的快捷方式默认直接显示文件本身的图标。"/>

            <TextBlock Classes="l-instructive" TextWrapping="Wrap"
                       Text="{Binding PathModeBaseHint}"/>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 2 0 0">
                <Button Click="OnOpenInternalFolder">
                    <ci:IconText Glyph="&#xE8B7;" Text="打开插件内部目录"/>
                </Button>
                <Button Click="OnCleanupInternalFiles">
                    <ci:IconText Glyph="&#xE74D;" Text="清理未使用的副本"/>
                </Button>
                <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.7"
                           TextWrapping="Wrap" Text="{Binding InternalFolderSummary}"/>
            </StackPanel>

            <TextBlock IsVisible="{Binding HasShortcutActionMessage}"
                       FontSize="12" TextWrapping="Wrap" Margin="0 2 0 0"
                       Text="{Binding ShortcutActionMessage}"/>

            <!-- 顺序预览：和工具条一样的排布（左一半 · 主按钮 · 右一半），
                 每一颗都能直接拖着换位置。 -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0 6 0 0">
                <StackPanel Spacing="10">
                    <TextBlock Text="顺序预览 · 按住拖动可调整位置" FontWeight="SemiBold"/>
                    <Panel x:Name="PreviewHost"/>
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="「幸运抽签」固定在按钮里、不参与排序；其余按这里的顺序从左到右排列。"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0 10 0 0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="12" Margin="0 0 0 8">
                            <StackPanel Spacing="8">

                                <!-- 第一行：图标 · 名称 · 类型 · 排序删除 -->
                                <Grid ColumnDefinitions="64,Auto,*,190,Auto,Auto,Auto">
                                    <TextBox Grid.Column="0" Watermark="图标"
                                             ToolTip.Tip="填一个 emoji，或者填一个汉字（比如「投」「网」）。留空则按类型自动给一个；指向文件的快捷方式会优先用文件本身的图标。"
                                             Text="{Binding Icon, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" Margin="4 0 0 0" Width="46"
                                              ToolTip.Tip="从常用图标里挑一个"
                                              ItemsSource="{Binding IconOptions}"
                                              SelectedIndex="{Binding IconPresetIndex, Mode=TwoWay}"/>
                                    <TextBox Grid.Column="2" Margin="8 0 0 0" Watermark="名称（按钮上显示，最多 6 个字）"
                                             Text="{Binding Name, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="3" Margin="8 0 0 0" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding KindOptions}"
                                              SelectedIndex="{Binding KindIndex, Mode=TwoWay}"/>
                                    <Button Grid.Column="4" Margin="8 0 0 0" Content="上移"
                                            Click="OnMoveShortcutUp" Tag="{Binding}"/>
                                    <Button Grid.Column="5" Margin="6 0 0 0" Content="下移"
                                            Click="OnMoveShortcutDown" Tag="{Binding}"/>
                                    <Button Grid.Column="6" Margin="6 0 0 0" Content="删除"
                                            Click="OnDeleteShortcut" Tag="{Binding}"/>
                                </Grid>

                                <!-- 第二行：目标，按类型切换 -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" IsVisible="{Binding IsCommand}"
                                             Watermark="{Binding TargetWatermark}"
                                             Text="{Binding Target, Mode=TwoWay}"/>
                                    <Button Grid.Column="1" Margin="8 0 0 0" IsVisible="{Binding IsCommand}"
                                            Content="浏览…" Click="OnBrowseProgram" Tag="{Binding}"/>

                                    <TextBox Grid.Column="0" IsVisible="{Binding IsUrl}"
                                             Watermark="{Binding TargetWatermark}"
                                             Text="{Binding Target, Mode=TwoWay}"/>

                                    <TextBox Grid.Column="0" IsVisible="{Binding IsPath}"
                                             Watermark="{Binding TargetWatermark}"
                                             Text="{Binding Target, Mode=TwoWay}"/>
                                    <!-- 绝对路径：老样子，选文件 / 选文件夹 -->
                                    <Button Grid.Column="1" Margin="8 0 0 0" IsVisible="{Binding IsPathAbsolute}"
                                            Content="选文件" Click="OnBrowseFile" Tag="{Binding}"/>
                                    <Button Grid.Column="2" Margin="6 0 0 0" IsVisible="{Binding IsPathAbsolute}"
                                            Content="选文件夹" Click="OnBrowseFolder" Tag="{Binding}"/>
                                    <!-- 相对路径：选完自动换算成相对 ClassIsland 数据根目录的形式 -->
                                    <Button Grid.Column="1" Margin="8 0 0 0" IsVisible="{Binding IsPathRelative}"
                                            ToolTip.Tip="选一个文件，自动换算成相对 ClassIsland 数据根目录的路径"
                                            Content="选文件并转相对路径" Click="OnBrowseFileRelative" Tag="{Binding}"/>
                                    <!-- 内部副本：把文件复制一份进插件自己的目录 -->
                                    <Button Grid.Column="1" Margin="8 0 0 0" IsVisible="{Binding IsPathInternal}"
                                            ToolTip.Tip="把文件复制一份到插件内部目录，原文件放哪都不影响"
                                            Content="保存副本…" Click="OnStoreInternalCopy" Tag="{Binding}"/>

                                    <TextBox Grid.Column="0" IsVisible="{Binding IsUri}"
                                             Watermark="{Binding TargetWatermark}"
                                             Text="{Binding Target, Mode=TwoWay}"/>
                                    <ComboBox Grid.Column="1" Margin="8 0 0 0" MinWidth="104"
                                              IsVisible="{Binding IsUri}"
                                              ToolTip.Tip="挑一个常用地址填进去"
                                              ItemsSource="{Binding UriOptions}"
                                              SelectedIndex="{Binding UriPresetIndex, Mode=TwoWay}"/>
                                </Grid>

                                <!-- 第三行：只有启动程序才有参数和管理员 -->
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsCommand}">
                                    <TextBox Grid.Column="0" Watermark="命令行参数（可留空）"
                                             Text="{Binding Arguments, Mode=TwoWay}"/>
                                    <CheckBox Grid.Column="1" Margin="10 0 0 0" Content="管理员运行"
                                              ToolTip.Tip="勾上会用 runas 启动，会弹 UAC。"
                                              IsChecked="{Binding RunAsAdmin, Mode=TwoWay}"/>
                                </Grid>

                                <!-- 路径方式：只有「打开文件或文件夹」才有 -->
                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsPath}">
                                    <TextBlock Grid.Column="0" Text="路径方式" VerticalAlignment="Center"
                                               Margin="0 0 10 0" Opacity="0.8"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="180"
                                              ItemsSource="{Binding PathModeOptions}"
                                              SelectedIndex="{Binding PathModeIndex, Mode=TwoWay}"/>
                                </Grid>
                                <TextBlock IsVisible="{Binding IsPath}" FontSize="12" Opacity="0.65"
                                           TextWrapping="Wrap" Text="{Binding PathModeHint}"/>
                                <!-- 解析结果摊开给用户核对：相对路径/内部副本最容易「填了但指错地方」 -->
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            IsVisible="{Binding ShowResolvedTarget}">
                                    <TextBlock FontSize="12" Opacity="0.65" Text="实际打开："/>
                                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                               Text="{Binding ResolvedTarget}"/>
                                </StackPanel>

                                <!-- 只有指向真实文件的类型才有「文件本身的图标」这回事 -->
                                <CheckBox Content="使用文件本身的图标（与资源管理器里显示的一致）"
                                          IsVisible="{Binding IsFileBased}"
                                          IsChecked="{Binding UseFileIcon, Mode=TwoWay}"/>

                                <CheckBox Content="需要确认（点两次才执行，防误触）"
                                          IsChecked="{Binding Confirm, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                <Button Click="OnAddShortcut">
                    <ci:IconText Glyph="&#xE710;" Text="添加一条快捷方式"/>
                </Button>
                <Button Click="OnAddPresetShortcuts">
                    <ci:IconText Glyph="&#xE8B0;" Text="添加常用示例"/>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
